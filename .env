# ================================================================
# RainCloud™ VPS Management — production configuration
# Fill TOKEN / ADMIN_ID / OWNER_ID before starting the bot.
# ================================================================

# Discord
TOKEN=MTU0NDU1MDY5MDM4MTM3MzYyMA.GPnHds.nBlVei23apeE54q9jXQC1l1Dfzyb9EwhZyumSM
ADMIN_ID=1493564911039811725

# Database / logs
DATABASE_FILE=vps_bot.db
LOG_FILE=vps_bot.log

# UI / defaults
BOT_STATUS_NAME=RGNODES™ VPS Management
PREFIX=-
VPS_HOSTNAME_PREFIX=rgnodes
DEFAULT_RAM=4G
DEFAULT_CPU=1
DEFAULT_DISK=10G
DEFAULT_LOCATION=SG

# Per-user / global capacity
SERVER_LIMIT=1
TOTAL_RUNNING_LIMIT=50
ADMIN_BYPASS_LIMITS=true

# Host allocation capacity (requested allocations)
HOST_TOTAL_RAM=64G
HOST_TOTAL_CPU=10
HOST_TOTAL_DISK=10T

# Runtime / Docker
STATUS_INTERVAL=45
PORT_SUPERVISOR_INTERVAL=20
DOCKER_TIMEOUT=120
ACCESS_TIMEOUT=120
DEPLOY_TIMEOUT=600
IMAGE_PULL_TIMEOUT=300
DOCKER_RETRIES=2
STATUS_CONCURRENCY=5
MEMORY_RESERVATION_PERCENT=75
DISABLE_CONTAINER_SWAP=true

# Port forwarding: maximum 10 TCP forwards per VPS
MAX_PORTS_PER_VPS=10
PORT_RANGE_START=20000
PORT_RANGE_END=40000

# Real public IPv4 + location verification
# The bot verifies the public egress IPv4 through multiple independent providers.
# There is NO /ipv4 command. The verified IPv4 is sent privately by DM.
PUBLIC_IP_REFRESH=300
IPV4_REFRESH=300
REAL_LOCATION_REFRESH=900
IPV4_MODE=shared
REQUIRE_REAL_PUBLIC_IPV4=true

# Optional storage quota / Docker compatibility
ENABLE_HARD_DISK_QUOTA=false
QUOTA_FALLBACK=true
DOCKER_FEATURE_FALLBACK=true
INTERACTION_LOG_UNKNOWN_AS_DEBUG=true
