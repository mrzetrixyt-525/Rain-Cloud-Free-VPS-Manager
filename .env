# ============================================================
# RGNODES™ VM MANAGER — .env
# ============================================================

# Discord
DISCORD_TOKEN=
TOKEN=
BOT_TOKEN=
ADMIN_ID=1493564911039811725
DISCORD_GUILD_ID=
PREFIX=-

# Database / logs
DATABASE_FILE=rgnodes_vm.db
LOG_FILE=rgnodes_vm.log

# Dashboard
WEB_HOST=0.0.0.0
WEB_PORT=3399
WEB_PUBLIC_URL=
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
WEB_ADMIN_PASSWORD_HASH=
COOKIE_SECURE=0
SESSION_TTL=28800
LOGIN_WINDOW=300
LOGIN_MAX_FAILURES=8

# VPS backend
# auto = KVM when available, otherwise QEMU
# kvm = force KVM/libvirt
# qemu = force software QEMU
# docker = Docker
# pterodactyl = Pterodactyl
VPS_BACKEND=auto

# VPS defaults
DEFAULT_RAM=8G
DEFAULT_CPU=2
DEFAULT_DISK=25G
DEFAULT_LOCATION=IN
SERVER_LIMIT=1
TOTAL_RUNNING_LIMIT=500
ADMIN_BYPASS_LIMITS=true

# KVM / QEMU
KVM_STORAGE=/var/lib/rgnodes/vms
KVM_NETWORK=default
KVM_BRIDGE=
KVM_ARCH=x86_64
KVM_MACHINE=q35
KVM_FIRMWARE=bios
KVM_DISK_FORMAT=qcow2
KVM_VCPUS_MAX=64
KVM_RAM_MAX_GB=256
KVM_DISK_MAX_GB=1000
KVM_AUTOSTART=0
KVM_REQUIRE_KVM=0

# Trusted base images
# Example:
# KVM_BASE_IMAGES_JSON={"ubuntu-24.04":"/var/lib/rgnodes/images/ubuntu-24.04.qcow2","ubuntu-22.04":"/var/lib/rgnodes/images/ubuntu-22.04.qcow2","debian-12":"/var/lib/rgnodes/images/debian-12.qcow2","debian-11":"/var/lib/rgnodes/images/debian-11.qcow2"}
KVM_BASE_IMAGES_JSON={}

# Optional per-OS image variables
KVM_BASE_IMAGE_UBUNTU_24_04=
KVM_BASE_IMAGE_UBUNTU_22_04=
KVM_BASE_IMAGE_DEBIAN_12=
KVM_BASE_IMAGE_DEBIAN_11=

# Guest first-boot provisioning
GUEST_PROVISION_ON_CREATE=true
GUEST_PROVISION_TIMEOUT=900
GUEST_SSH_PORT=22
GUEST_NODE_MAJOR=20
GUEST_INSTALL_YARN=true
GUEST_INSTALL_PNPM=true
GUEST_INSTALL_PM2=true
GUEST_INSTALL_SSHX=true
GUEST_INSTALL_DOCKER=true
GUEST_INSTALL_DOCKER_COMPOSE=true
GUEST_INSTALL_MARIADB=true
GUEST_INSTALL_REDIS=true
GUEST_INSTALL_NGINX=true
GUEST_INSTALL_CERTBOT=true
GUEST_INSTALL_PHP=true
GUEST_FULL_UPGRADE=true

# SSHx
SSHX_ENABLED=true
SSHX_NAME=RGNODES™ ;D
SSHX_TIMEOUT=100
SSHX_START_TIMEOUT=45
SSHX_REUSE_SESSION=true
SSHX_DIR=/var/lib/rgnodes/sshx

# Abuse protection
ABUSE_ENABLED=true
ABUSE_SCAN_INTERVAL=30
ABUSE_AUTO_SUSPEND=true
ABUSE_AUTO_DELETE=true
ABUSE_AUTO_BAN=true
ABUSE_CONN_THRESHOLD=800
ABUSE_DEST_THRESHOLD=120
ABUSE_CONFIRMATIONS_TO_SUSPEND=2
ABUSE_CONFIRMATIONS_TO_DELETE=3
ABUSE_TERMS=masscan,nmap,zmap,nikto,sqlmap,hydra,medusa,metasploit,msfconsole,hping3,slowloris,aircrack,ettercap,bettercap

# Resource / network protection
MAX_PORTS_PER_VPS=10
PORT_RANGE_START=20000
PORT_RANGE_END=40000
TOTAL_BANDWIDTH_LIMIT_MBPS=0

# Pterodactyl
PTERO_URL=
PTERO_API_KEY=
PTERO_CLIENT_API_KEY=
PTERO_PANEL_PUBLIC_URL=
PTERO_NODE_ID=0
PTERO_NEST_ID=0
PTERO_EGG_ID=0
PTERO_ALLOCATION_ID=0
PTERO_DEFAULT_USER_ID=0
PTERO_AUTO_CREATE_USERS=true

# Docker fallback
DOCKER_TIMEOUT=120
DOCKER_RETRIES=2
DOCKER_MANAGE_DAEMON=false
ENABLE_HARD_DISK_QUOTA=false
QUOTA_FALLBACK=true

# Discord/network resilience
DISCORD_API_TIMEOUT=10
DISCORD_LOGIN_RETRY_BASE=5
DISCORD_LOGIN_RETRY_MAX=120
DISCORD_LOGIN_MAX_ATTEMPTS=0

# Process singleton
SINGLETON_LOCK_FILE=/tmp/rgnodes-vm-manager.lock

# Optional branding
BOT_STATUS_NAME=RGNODES™ VPS Management
VPS_HOSTNAME_PREFIX=rgnodes-vps
FOOTER_TEXT=⚡ RGNODES™ • VPS Management
