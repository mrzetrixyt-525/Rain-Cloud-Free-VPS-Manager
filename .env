# ================================================================
# RGNODES™ VPS Manager — local guest VM/container provisioning
# Pterodactyl API is NOT used to create VPS instances.
# ================================================================

TOKEN=
ADMIN_ID=
PREFIX=-
DATABASE_FILE=vps_bot.db
LOG_FILE=vps_bot.log
BOT_STATUS_NAME=RGNODES™ VPS

DEFAULT_LOCATION=IN
DEFAULT_RAM=10G
DEFAULT_CPU=3
DEFAULT_DISK=50G
SERVER_LIMIT=1
TOTAL_RUNNING_LIMIT=500
ADMIN_BYPASS_LIMITS=true

# Guest provisioning
GUEST_SYSTEMD_ENABLED=true
GUEST_NESTED_DOCKER=true
GUEST_SYSTEMD_PRIVILEGED=true
GUEST_CGROUPNS_HOST=true
GUEST_KVM_ENABLED=true
GUEST_INSTALL_WINGS=true
GUEST_INSTALL_WEB_STACK=true
GUEST_INSTALL_DATABASE_STACK=true
GUEST_BOOTSTRAP_TIMEOUT=1200
GUEST_DOCKER_PACKAGE=docker.io
GUEST_PERSISTENT_DATA=true

# Docker/runtime safety
MANAGE_DOCKER_DAEMON=false
DOCKER_TIMEOUT=120
DOCKER_RETRIES=2
MEMORY_RESERVATION_PERCENT=75
DISABLE_CONTAINER_SWAP=true
ENABLE_HARD_DISK_QUOTA=false
QUOTA_FALLBACK=true
DOCKER_FEATURE_FALLBACK=true

# Existing HTTP health system
WEB_HOST=0.0.0.0
WEB_PORT=247
USE_PLATFORM_PORT=false
WEB_PATH=/

# Existing SSHx system
SSHX_TOTAL_TIMEOUT=100
SSHX_START_TIMEOUT=45
SSHX_POLL_SECONDS=30

# Capacity defaults
HOST_TOTAL_RAM=644G
HOST_TOTAL_CPU=104
HOST_TOTAL_DISK=104T
MAX_PORTS_PER_VPS=10
PORT_RANGE_START=1
PORT_RANGE_END=400000
PORT_SUPERVISOR_INTERVAL=20
PUBLIC_IP_REFRESH=300
REAL_LOCATION_REFRESH=900
IPV4_MODE=shared
REQUIRE_REAL_PUBLIC_IPV4=true
IPV4_REFRESH=300

# These old Pterodactyl API fields are intentionally NOT required for VPS creation.
# Pterodactyl Panel/Wings support is provisioned INSIDE the guest instead.
